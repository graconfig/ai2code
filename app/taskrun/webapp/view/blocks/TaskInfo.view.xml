<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns:forms="sap.ui.layout.form" xmlns="sap.m">
	<forms:SimpleForm editable="true" layout="ColumnLayout">

    <Label text="Name" />
    <Input id="name" value="{name}" editable="false"/>
    <Label text="Description" />
    <Input value="{description}" editable="false"></Input>
    <Label text="Context Path" />
    <Input value="{contextPath}" editable="false"></Input>
    <Label text="Sequence" />
    <Input value="{sequence}" editable="false"/>
    <Label text="isMain" />
    <CheckBox selected="{isMain}" editable="false"/>

	</forms:SimpleForm>
</mvc:View>
