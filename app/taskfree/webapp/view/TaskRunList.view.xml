<mvc:View
    controllerName="ai.orchestration.taskfree.controller.TaskRunList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:plugins="sap.m.plugins"
    displayBlock="true"
    height="100%">
    
    <f:DynamicPage id="dynamicPageId">
        <!-- DynamicPage Title -->
        <f:title>
            <f:DynamicPageTitle id="dynamicPageTitle">
                <f:heading>
                    <Title id="pageTitle" text="AI2Code Orchestration" level="H1"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        
        <!-- DynamicPage Header -->
        <f:header>
            <f:DynamicPageHeader id="dynamicPageHeader" pinnable="true">
                <f:content>
                    <SearchField
                        id="searchField"
                        width="300px"
                        placeholder="Search tasks..."
                        search="onSearch"
                        class="sapUiSmallMargin"/>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        
        <f:content>
            <!-- Table View -->
            <Table
                id="taskTable"
                items="{
                    path: '/Tasks',
                    sorter: {
                        path: 'modifiedAt',
                        descending: true
                    },
                    filters: {
                        path: 'isMain',
                        operator: 'EQ',
                        value1: true
                    }
                }"
                growing="true"
                growingThreshold="20"
                mode="MultiSelect"
                popinLayout="GridSmall">

                <dependents>
                    <plugins:ColumnResizer id="columnResizer" />
                </dependents>
                
                <headerToolbar>
                    <OverflowToolbar id="tableToolbar">
                        <Title id="tableTitle" text="Tasks ({/Tasks/$count})" level="H2"/>
                        <ToolbarSpacer id="toolbarSpacer"/>
                        <Button 
                            id="toolbarCreateButton"
                            text="Create"
                            press="onCreate"/>
                        <Button 
                            id="toolbarDeleteButton"
                            text="Delete"
                            tooltip="Delete"
                            press="onDelete"
                            type="Transparent"/>
                    </OverflowToolbar>
                </headerToolbar>
                
                                  <columns>
                      <Column id="nameColumn">
                         <Text id="nameHeader" text="Main Task"/>
                      </Column>
                      <Column id="descriptionColumn" width="20%" minScreenWidth="Tablet" demandPopin="true">
                         <Text id="descriptionHeader" text="Description"/>
                      </Column>
                      <Column id="typeName" width="15%" minScreenWidth="Tablet" demandPopin="true">
                         <Text id="typeNameHeader" text="Task Type"/>
                      </Column>
                      <Column id="typeDesc" width="20%" minScreenWidth="Desktop" demandPopin="true">
                         <Text id="typeDescHeader" text="Type Description"/>
                      </Column>
                      <Column id="createdBy" width="12%" minScreenWidth="Desktop" demandPopin="true">
                         <Text id="createdByHeader" text="Created By"/>
                      </Column>
                      <Column id="createdAt" width="13%" minScreenWidth="Desktop" demandPopin="true">
                         <Text id="createdAtHeader" text="Created At"/>
                      </Column>
                  </columns>
                
                <items>
                    <ColumnListItem 
                        id="taskTableItem"
                        press="onItemPress"
                        type="Navigation">
                                                 <cells>
                             <VBox id="nameCell">
                                 <Text id="nameText" text="{name}" wrapping="false" class="sapUiTinyMarginBottom"/>
                             </VBox>
                             <Text id="descriptionText" text="{description}" wrapping="true" maxLines="3"/>
                             <Text id="typeNameText" text="{type/name}" wrapping="false"/>
                             <Text id="typeDescText" text="{type/description}" wrapping="false"/>
                             <Text id="createdByText" text="{createdBy}" wrapping="false"/>
                             <Text id="createdAtText" text="{createdAt}" wrapping="false"/>
                         </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
        
        <!-- DynamicPage Footer -->
        <f:footer>
            <OverflowToolbar id="footerToolbar">
                <ToolbarSpacer id="footerSpacer"/>
                <Button id="exportButton" text="Export" icon="sap-icon://excel-attachment" press="onExport"/>
                <Button id="settingsButton" text="Settings" icon="sap-icon://action-settings" press="onSettings"/>
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>
