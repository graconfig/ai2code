<mvc:View
    controllerName="ai.orchestration.taskfree.controller.AIConversationPage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:custom="ai.orchestration.taskfree.control"
    xmlns:core="sap.ui.core"
    core:require="{
        ChatFormatter: 'ai/orchestration/taskfree/formatter/ChatFormatter'
    }"
    height="100%">
    
    <Page id="aiConversationPage" showHeader="false" title="AI Conversation" class="aiConversationPage aiConversationFullWidth">
        <headerContent>
            <Button id="refreshButton" icon="sap-icon://refresh" press="onRefreshPress" tooltip="{i18n>refreshButtonTooltip}"/>
        </headerContent>
        
        <content>
            <Page id="chatPage" class="sapUiContentPadding chatPage" showFooter="true"
            floatingFooter="false" showHeader="false">
            
            <Toolbar id="conversationPanelToolbar">
                <Title id="conversationPanelTitle" text="Conversation"/>
                <ToolbarSpacer id="conversationPanelSpacer"/>
                <Button id="clearButton" icon="sap-icon://delete" press="onClearPress" tooltip="{i18n>clearButtonTooltip}" type="Transparent"/>
            </Toolbar>
                    
            <content>
                <VBox id="_IDGenVBox" class="sapUiMediumMarginBottom">
                    <List
                            id="aiPageMessageList"
                            showNoData="true"
                            noDataText="No messages yet. Start a conversation below."
                            showSeparators="Inner"
                            items="{ 
                                path: 'messages', 
                                sorter: { path: 'modifiedAt', descending: false },
                                filters: {
                                    path: 'role',
                                    operator: 'NE',
                                    value1: 'system'
                                },
                                parameters: {
                                    $$updateGroupId: 'changes',
                                    $count: true
                                }
                            }"
                        >
                            <custom:ChatMessageListItem id="chatMessageListItem"
                                message="{message}"
                                sender="{role}"
                                date="{createdAt}"
                            >
                                <custom:avatar>
                                    <Avatar id="messageAvatar"
                                        displaySize="S"
                                        src="{ path: 'role', formatter: 'ChatFormatter.senderIcon' }"
                                        displayShape="Square"
                                        backgroundColor="Transparent"
                                    />
                                </custom:avatar>

                                <custom:adopt>
                                    <Button id="adoptButton"
                                        class="sapUiTinyMarginBegin"
                                        type="Emphasized"
                                        icon="sap-icon://thumb-up"
                                        text="Adopt"
                                        press="onBtnAdoptPress"
                                        busyIndicatorDelay="0"
                                        visible="{= %{role} === 'assistant' }"
                                    />
                                </custom:adopt>
                            </custom:ChatMessageListItem>
                        </List>
                    <Text id="aiPageListEndMarker" text="" visible="false"/>
                </VBox>
            </content>
            <footer class="sapMPageFooter">
                <OverflowToolbar id="_IDGenOverflowToolbar">
                    <FeedInput
                                id="aiPageMessageInput"
                                post="onPostMessage"
                                showIcon="false"
                                growing="true"
                                placeholder="Type your message here..."
                                maxLength="2000"
                            />
                </OverflowToolbar>
            </footer>
        </Page>
        </content>
    </Page>
</mvc:View> 