<mvc:View
    controllerName="ai.orchestration.taskfree.controller.AIConversationStreamingPage"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:custom="ai.orchestration.taskfree.control"
    xmlns:core="sap.ui.core"
    core:require="{
        LayoutManager: 'ai/orchestration/taskfree/util/LayoutManager',
        ChatFormatter: 'ai/orchestration/taskfree/formatter/ChatFormatter'
    }"
    height="98%"
>
    <Page
        id="aiConversationPage"
        showHeader="false"
        class="aiConversationPage aiConversationFullWidth"
    >
        <headerContent>
            <Button
                id="refreshButton"
                icon="sap-icon://refresh"
                press="onRefreshPress"
                tooltip="{i18n>refreshButtonTooltip}"
            />
        </headerContent>

        <content>
            <Page
                id="aiChatPage"
                class="sapUiContentPadding chatPage"
                showFooter="true"
                floatingFooter="false"
                showHeader="false"
            >
                <Toolbar id="conversationPanelToolbar">
                    <Title
                        id="conversationPanelTitle"
                        text="{type/name}"
                    />
                    <ToolbarSpacer id="conversationPanelSpacer" />
                    <!-- 
                    <Button
                        id="clearButton"
                        icon="sap-icon://delete"
                        press="onClearPress"
                        tooltip="{i18n>clearButtonTooltip}"
                        type="Emphasized"
                    />
                    -->
                    <Button
                        id="gotoContextButton"
                        text="Go To Context"
                        press="onGotoContextPress"
                        tooltip="{i18n>clearButtonTooltip}"
                        type="Emphasized"
                    />
                </Toolbar>

                <content>
                    <VBox
                        id="aiMessageVBox"
                        class="sapUiMediumMarginBottom"
                    >
                        <List
                            id="aiPageMessageList"
                            showNoData="true"
                            noDataText="No messages yet. Start a conversation below."
                            showSeparators="Inner"
                            items="{ 
                                path: 'local>/messages', 
                                sorter: { path: 'createdAt', descending: false },
                                filters: {
                                    path: 'role',
                                    operator: 'NE',
                                    value1: 'system'
                                },
                                parameters: {
                                    $$updateGroupId: 'changes',
                                    $count: true
                                }
                            }"
                        >
                            <custom:ChatMessageListItem
                                id="chatMessageListItem"
                                message="{local>message}"
                                sender="{local>role}"
                                 date="{local>createdAt}"
                            >
                                <custom:avatar>
                                    <Avatar
                                        id="messageAvatar"
                                        displaySize="S"
                                        src="{ path: 'local>role', formatter: 'ChatFormatter.senderIcon' }"
                                        displayShape="Square"
                                        backgroundColor="Transparent"
                                    />
                                </custom:avatar>
                                <custom:adopt>
                                    <Button
                                        id="adoptButton"
                                        class="sapUiTinyMarginBegin"
                                        type="Emphasized"
                                        icon="sap-icon://thumb-up"
                                        text="Adopt"
                                        press="onBtnAdoptPress"
                                        busyIndicatorDelay="0"
                                        visible="{= %{local>role} === 'assistant' }"
                                    />
                                </custom:adopt>
                            </custom:ChatMessageListItem>
                        </List>
                        <Text
                            id="aiPageListEndMarker"
                            text=""
                            visible="false"
                        />
                    </VBox>
                </content>
                <footer>
                    <OverflowToolbar id="aiInputToolbar">
                        <FeedInput
                            id="aiPageMessageInput"
                            post="onPostMessage"
                            showIcon="false"
                            growing="true"
                            placeholder="Type your message here..."
                        />
                    </OverflowToolbar>
                </footer>
            </Page>
        </content>
    </Page>
</mvc:View>
