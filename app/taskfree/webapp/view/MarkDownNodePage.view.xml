<!-- MarkDownNodePage.view.xml -->
<mvc:View
  controllerName="ai.orchestration.taskfree.controller.MarkDownNodePage"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:u="sap.ui.richtexteditor"
  xmlns:c="sap.ui.core">
  <Page id="MarkDownNodePage" title="{viewModel>/title}">
  		<customHeader>
			<Bar id="markdownNodePageHeader">
				<contentLeft>
					<Title id="markdownNodePageTitle" text="{viewModel>/title}" level="H2" />
				</contentLeft>
				<contentRight>
					<Button id="markdownNodeReturnBtn"
						text="Return To Bot"
						type="Emphasized"
						press="onReturnToBot"
						visible="true" />
				</contentRight>
			</Bar>
		</customHeader>

    <content>
      <!-- <c:HTML id="markdownContent"></c:HTML> -->
      <u:RichTextEditor 
			id="idRichTextEditor"
			customToolbar="true"
			showGroupFont="true"
			showGroupLink="true"
			showGroupInsert="true"
			width="100%"
			height="50rem"
			></u:RichTextEditor>
    </content>
  </Page>
</mvc:View>