<mvc:View
    controllerName="ai.orchestration.taskfree.controller.ContextNodeDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    height="100%">
	<Page id="contextNodeDetailPage" showHeader="true" title="Context Node Detail">
		<content>
			<VBox id="contextNodeValueContainer" class="sapUiMediumMargin">
				<Text id="contextNodeValueText" text="{value}" wrapping="true" class="sapUiLargeText"/>
			</VBox>
		</content>
	</Page>
</mvc:View>