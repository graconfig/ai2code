<mvc:View
    controllerName="ai.orchestration.taskfree.controller.TaskDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    height="100%">
	<Page id="taskDetailPage" showHeader="true" title="Task Detail">
		<content>
			<VBox id="taskDescriptionContainer" class="sapUiMediumMargin">
				<Text id="taskDescriptionText" text="{description}" wrapping="true" class="sapUiLargeText"/>
			</VBox>
		</content>
	</Page>
</mvc:View> 