<mvc:View
    controllerName="ai.orchestration.taskfree.controller.BotInstanceDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    height="100%"
>
    <Page
        id="botInstanceDetailPage"
        showHeader="true"
        title="Bot Instance Detail"
    >
        <landmarkInfo>
            <PageAccessibleLandmarkInfo
                id="botInstanceDetailPageLandmarkInfo"
                rootRole="Region"
                rootLabel="Bot Instance Detail"
                contentRole="Main"
                contentLabel="Bot Instance Detail Content"
            />
        </landmarkInfo>
        <headerContent>
            <Button
                id="aiChatButton"
                text="AI Chat"
                icon="sap-icon://da-2"
                press="onAIChatPress"
                visible="false"
            />
            <Button
                id="gotoContextButton"
                text="Go To Context"
                press="onGotoContextPress"
                tooltip="{i18n>clearButtonTooltip}"
                type="Emphasized"
            />
            <Button
                id="executeButton"
                text="Execute"
                type="Emphasized"
                press="onExecuteButtonPress"
            />
        </headerContent>
        <content>
            <Text
                id="botInstanceResultText"
                text="{result}"
                maxLines="5"
            />
        </content>
    </Page>
</mvc:View>